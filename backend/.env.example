# Anthropic API key used to generate the natural-language BI narrative
ANTHROPIC_API_KEY=your_api_key_here

# Model used for report drafting
ANTHROPIC_MODEL=claude-sonnet-4-6

# Max rows sampled from large datasets before profiling (keeps prompts small & fast)
MAX_PROFILE_ROWS=200000

# Where uploaded files & generated reports/charts are stored
STORAGE_DIR=storage

# CORS - frontend origin
FRONTEND_ORIGIN=http://localhost:5173
